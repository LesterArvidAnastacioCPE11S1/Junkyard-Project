# REQUIRED: a long random string used to encrypt saved mailbox passwords.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it safe and don't change it later, or saved mailboxes must be reconnected.
APP_SECRET=

# Accounts
ALLOW_SIGNUP=1          # set to 0 once your shops are created, if the server is public
TOKEN_DAYS=30           # how long a device stays logged in

# Email: how often (seconds) to check every shop's mailbox. 0 = off.
EMAIL_POLL_SECONDS=60

# Messenger: one Meta app for the whole system
FB_VERIFY_TOKEN=any-secret-string-you-choose
FB_APP_SECRET=

# Only if you build a browser-based app (comma-separated origins). Leave empty for a mobile app.
CORS_ORIGINS=
