# Leave INGEST_KEY empty for a local demo. Set it once a phone or Messenger can reach your PC.
INGEST_KEY=

# Email (IMAP) - the junkshop's own mailbox
IMAP_HOST=imap.gmail.com
IMAP_USER=yourshop@gmail.com
IMAP_PASSWORD=your-16-character-app-password
IMAP_FOLDER=INBOX
API_URL=http://127.0.0.1:8000
POLL_SECONDS=30

# Messenger (from your Meta app)
FB_VERIFY_TOKEN=any-secret-string-you-choose
FB_APP_SECRET=